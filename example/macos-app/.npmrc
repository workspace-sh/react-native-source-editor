# react-native-webview peers on react-native-macos, which conflicts with the
# app's direct react-native pin. react-native-macos apps live with this — the
# canonical workaround is legacy peer-dep resolution. Making it sticky here
# (rather than relying on a `--legacy-peer-deps` flag at every call site)
# keeps `npm install` working identically across local dev and CI, regardless
# of npm version or how the install is invoked.
legacy-peer-deps=true
