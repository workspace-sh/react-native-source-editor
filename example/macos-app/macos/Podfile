require 'pathname'

ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb"

# STTextView is SPM-only; the cocoapods-spm plugin bridges it into the
# Pods project. Unlike the iOS example (which gets this injected by our
# Expo config plugin during prebuild) react-native-macos has no CNG
# step, so the wiring lives directly in the Podfile.
plugin 'cocoapods-spm'

prepare_react_native_project!

target 'MacosApp-macOS' do
  platform :macos, '14.0'
  use_native_modules!

  spm_pkg 'STTextView',
    :url => 'https://github.com/krzyzanowskim/STTextView.git',
    :version => '2.3.10',
    :products => ['STTextView']

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => '../node_modules/react-native-macos',
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(installer)

    # `fmt` (vendored by RN) hits "call to consteval function ... is not
    # a constant expression" on Xcode 16/17 + macOS 14. The error is
    # raised in fmt's headers but instantiated in EVERY pod that includes
    # them (RCT-Folly, React-jsi, …) — so the define has to land on every
    # consumer, not just the fmt target. Apply at the umbrella-project
    # level (xcconfig) AND on each target for belt-and-braces.
    apply_fmt_define = lambda do |config|
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = [defs] unless defs.is_a?(Array)
      defs << 'FMT_USE_CONSTEVAL=0' unless defs.include?('FMT_USE_CONSTEVAL=0')
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
      cxxflags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
      unless cxxflags.to_s.include?('-DFMT_USE_CONSTEVAL=0')
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{cxxflags} -DFMT_USE_CONSTEVAL=0"
      end
    end

    installer.pods_project.build_configurations.each(&apply_fmt_define)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each(&apply_fmt_define)
    end
  end
end
