require 'pathname'

ws_dir = Pathname.new(__dir__)
ws_dir = ws_dir.parent until
  File.exist?("#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb") ||
  ws_dir.expand_path.to_s == '/'
require "#{ws_dir}/node_modules/react-native-macos/scripts/react_native_pods.rb"

# STTextView is SPM-only; the cocoapods-spm plugin bridges it into the
# Pods project. Unlike the iOS example (which gets this injected by our
# Expo config plugin during prebuild) react-native-macos has no CNG
# step, so the wiring lives directly in the Podfile.
plugin 'cocoapods-spm'

prepare_react_native_project!

target 'MacosApp-macOS' do
  platform :macos, '14.0'
  use_native_modules!

  spm_pkg 'STTextView',
    :url => 'https://github.com/krzyzanowskim/STTextView.git',
    :version => '2.3.10',
    :products => ['STTextView']

  # Flags change depending on the env values.
  flags = get_default_flags()

  use_react_native!(
    :path => '../node_modules/react-native-macos',
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(installer)

    # fmt 11 + Apple Clang in C++20 mode raises "call to consteval
    # function … is not a constant expression" inside fmt's headers
    # whenever any pod (RCT-Folly, React-jsi, …) includes them. We
    # patch every fmt header that defines the macro (base.h is the
    # primary one in fmt 11, but we also touch core.h / format.h if
    # they exist), AND we inject the same define into every xcconfig
    # so consumers don't even reach the auto-detection.
    patch_marker = '// rnse-fmt-consteval-patch'
    patch_header = "#{patch_marker}\n" \
                   "#ifndef FMT_USE_CONSTEVAL\n" \
                   "#define FMT_USE_CONSTEVAL 0\n" \
                   "#endif\n\n"

    fmt_dir = File.join(installer.sandbox.root.to_s, 'fmt', 'include', 'fmt')
    Pod::UI.puts "[rnse-fmt-patch] sandbox=#{installer.sandbox.root}"
    Pod::UI.puts "[rnse-fmt-patch] fmt_dir exists=#{File.directory?(fmt_dir)}"

    %w[base.h core.h format.h].each do |name|
      path = File.join(fmt_dir, name)
      next unless File.exist?(path)
      text = File.read(path)
      if text.include?(patch_marker)
        Pod::UI.puts "[rnse-fmt-patch] already patched: #{name}"
      else
        File.write(path, patch_header + text)
        Pod::UI.puts "[rnse-fmt-patch] patched: #{name}"
      end
    end

    # Belt-and-braces: append the define to every xcconfig under the
    # sandbox so a fmt header included BEFORE base.h still gets it.
    Dir.glob(File.join(installer.sandbox.root.to_s, '**', '*.xcconfig')).each do |xcconfig|
      contents = File.read(xcconfig)
      next if contents.include?('FMT_USE_CONSTEVAL=0')
      File.open(xcconfig, 'a') do |f|
        f.puts ''
        f.puts '// rnse-fmt-consteval-patch'
        f.puts 'GCC_PREPROCESSOR_DEFINITIONS = $(inherited) FMT_USE_CONSTEVAL=0'
      end
    end
  end
end
