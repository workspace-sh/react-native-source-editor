{
  "name": "@workspace-sh/react-native-source-editor",
  "version": "0.0.1",
  "description": "Native source editor for React Native, wrapping STTextView for iOS and macOS.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "typecheck": "tsc --noEmit",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "ios:plugin": "gem install cocoapods-spm",
    "ios:setup": "cd example/ios-app && npm install",
    "ios:pods": "cd example/ios-app/ios && pod install",
    "ios:start": "cd example/ios-app && npx expo start --dev-client",
    "ios:start:clean": "watchman watch-del-all && cd example/ios-app && npx expo start --dev-client --clear",
    "ios:run": "cd example/ios-app && npx expo run:ios",
    "ios:run:device": "cd example/ios-app && npx expo run:ios --device",
    "ios:run:release": "cd example/ios-app && npx expo run:ios --configuration Release",
    "ios:run:device:release": "cd example/ios-app && npx expo run:ios --device --configuration Release",
    "ios:dev": "concurrently \"npm run ios:start:clean\" \"npm run ios:run\"",
    "ios:open": "xed example/ios-app/ios"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "text-editor",
    "source-editor",
    "STTextView",
    "ios",
    "macos"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workspace-sh/react-native-source-editor.git"
  },
  "bugs": {
    "url": "https://github.com/workspace-sh/react-native-source-editor/issues"
  },
  "author": {
    "name": "Leslie Owusu-Appiah",
    "email": "leslieoa@pm.me",
    "url": "https://github.com/leslieoa"
  },
  "license": "MIT",
  "homepage": "https://github.com/workspace-sh/react-native-source-editor#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/react": "~19.1.1",
    "concurrently": "^9.1.0",
    "expo-module-scripts": "^55.0.2",
    "expo": "^55.0.18",
    "react-native": "0.82.1"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
